# ─────────────────────────────────────────────────────────────
# 🔴 رازها و داده‌ی مشتری — مهم‌ترین بخشِ این فایل.
# هر چیزی که یک بار commit شود، حتی اگر بعداً پاکش کنی، برای همیشه در
# تاریخچه‌ی گیت می‌ماند. پس جلویش باید از همین‌جا گرفته شود.
# ─────────────────────────────────────────────────────────────

# کلیدِ خصوصیِ امضای لایسنس. اگر لو برود، هر کسی می‌تواند لایسنسِ جعلی بسازد.
*.pem
*.key
yatash-private*

# لایسنس‌های صادرشده — تکی و پوشه‌ی مشتری‌ها (طبقِ GUIDE.md بخشِ ۵)
license.dat
licenses/

# متغیرهای محیطی؛ فقط نمونه‌ی بدونِ مقدار commit می‌شود
.env*
!.env.example

# فایلِ پشتیبانی که خودِ اپ می‌سازد. شاملِ نام، شماره‌ی تلفن و کلِ سوابقِ مالیِ
# مشتری‌های کارواش است — هرگز نباید وارد مخزن شود.
carwash_backup_*.json

# ─────────────────────────────────────────────────────────────
# خروجی‌های بیلد و وابستگی‌ها — با هر بار ساختن از نو تولید می‌شوند
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
build/
release/
*.tsbuildinfo
.vite/

# ─────────────────────────────────────────────────────────────
# تست و پوششِ کد
# ─────────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
.playwright/

# داده‌ی نمونه — خروجیِ «npm run seed» است و هر وقت لازم شد دوباره ساخته می‌شود
seed-backup.json

# ─────────────────────────────────────────────────────────────
# فایل‌های موقتِ سیستم‌عامل
# ─────────────────────────────────────────────────────────────
# مک
.DS_Store
# ویندوز — چون بیلدِ نهایی آنجا گرفته می‌شود
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────────────────────────────────────
# ابزارها و ادیتورها
# ─────────────────────────────────────────────────────────────
*.log
.idea/
# تنظیماتِ محلیِ Claude Code — مخصوصِ همین دستگاه است، نه پروژه
.claude/settings.local.json

# ─────────────────────────────────────────────────────────────
# گزارشِ نوبتِ جاری — هر بار کامل بازنویسی می‌شود، پس تاریخچه‌اش ارزشی ندارد.
# برخلافِ آن، pending.md و GUIDE.md عمداً commit می‌شوند.
# ─────────────────────────────────────────────────────────────
response.md
