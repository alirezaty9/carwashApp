{
  "name": "yatash-carwash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Yatash — offline carwash management app",
  "author": "Yatash",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --port=3000\" \"wait-on tcp:127.0.0.1:3000 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release test-results",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:all": "vite build && electron-builder --win --linux",
    "license:keygen": "node tools/license-gen.cjs keygen",
    "license:issue": "node tools/license-gen.cjs issue",
    "seed": "node tools/seed.cjs"
  },
  "_comment_dependencies": "فقط چیزی که برنامه‌ی نصب‌شده در زمانِ اجرا require می‌کند. هر چه اینجا بیاید داخلِ فایلِ نصبی بسته‌بندی می‌شود و حجمش را بالا می‌برد. React و lucide و ابزارهای بیلد عمداً اینجا نیستند، چون Vite آن‌ها را از قبل داخلِ dist/ ادغام کرده است.",
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.yatash.carwash",
    "productName": "Yatash Carwash",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Yatash Carwash"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "maintainer": "Yatash"
    }
  }
}
